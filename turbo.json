{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "env": ["CACHE_*"],
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:check": {
      "dependsOn": ["^lint:check"]
    },
    "test": {
      "dependsOn": ["^test"]
    }
  }
}
