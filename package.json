    "lint:check": "turbo run lint:check",
    "preinstall": "npx only-allow@1.2.2 pnpm"
  },
  "devDependencies": {
    "@openapi-contrib/json-schema-to-openapi-schema": "^2.2.5",
    "eslint": "^8.23.1",
    "jsonschema-bigquery": "^7.0.0",
    "prettier": "^3.0.3",
    "syncpack": "^13.0.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.3.0",
    "typescript": "~5.5.0",
    "typescript-json-schema": "^0.61.0",
    "turbo": "^2.1.3"
  },
  "engines": {
    "node": ">=18",
    "npm": "use-pnpm",
    "pnpm": "10.33.0",
    "yarn": "use-pnpm"
  },
  "packageManager": "pnpm@10.33.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "brace-expansion": ">=2.0.3",
      "effect": ">=3.20.0",
      "js-yaml": ">=4.1.1",
